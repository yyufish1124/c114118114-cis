      "execution_count": null,
      "outputs": [],
      "source": [
        "# [Code Cell] Mission 8-1：建立 quiz_score 欄位\n",
        "# 隨機誤差：平均 0、標準差 5\n",
        "random_noise = rng.normal(loc=0, scale=5, size=n)\n",
        "\n",
        "# 分項計算，每一行對應公式的一項\n",
        "base_score = 50\n",
        "study_part = 3 * df[\"study_hours\"]\n",
        "sleep_part = 2 * df[\"sleep_hours\"]\n",
        "screen_part = -1.2 * df[\"screen_time_hours\"]\n",
        "attendance_part = 0.15 * df[\"attendance_rate\"]\n",
        "\n",
        "# 加總各項，得到原始成績\n",
        "raw_score = (\n",
        "    base_score\n",
        "    + study_part\n",
        "    + sleep_part\n",
        "    + screen_part\n",
        "    + attendance_part\n",
        "    + random_noise\n",
        ")\n",
        "\n",
        "# 限制在 0～100 分，並四捨五入成整數\n",
        "df[\"quiz_score\"] = raw_score.clip(0, 100).round(0).astype(int)\n",
        "\n",
        "# 選取多個欄位，顯示前五筆\n",
        "df[\n",
        "    [\n",
        "        \"student_id\",\n",
        "        \"study_hours\",\n",
        "        \"sleep_hours\",\n",
        "        \"screen_time_hours\",\n",
        "        \"attendance_rate\",\n",
        "        \"quiz_score\"\n",
        "    ]\n",
        "].head()"
