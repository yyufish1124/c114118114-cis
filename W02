        "# [Code Cell] 最終整合版程式\n",
        "\n",
        "# ---------- 1. 匯入套件 ----------\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# ---------- 2. 基本設定 ----------\n",
        "student_count = 60\n",
        "random_seed = 42\n",
        "rng = np.random.default_rng(random_seed)   # 固定亂數種子，結果可重現\n",
        "n = student_count\n",
        "departments = [\"資訊管理\", \"企業管理\", \"金融管理\"]\n",
        "\n",
        "# ---------- 3. 產生模擬資料（順序固定，才能得到相同結果） ----------\n",
        "student_id = np.arange(1, n + 1)\n",
        "department = rng.choice(departments, size=n)\n",
        "sleep_hours = rng.normal(loc=6.7, scale=1.1, size=n)\n",
        "screen_time_hours = rng.normal(loc=5.0, scale=1.5, size=n)\n",
        "study_hours = rng.normal(loc=2.5, scale=1.0, size=n)\n",
        "attendance_rate = rng.normal(loc=88, scale=8, size=n)\n",
        "\n",
        "df = pd.DataFrame({\n",
        "    \"student_id\": student_id,\n",
        "    \"department\": department,\n",
        "    \"sleep_hours\": sleep_hours,\n",
        "    \"screen_time_hours\": screen_time_hours,\n",
        "    \"study_hours\": study_hours,\n",
        "    \"attendance_rate\": attendance_rate\n",
        "})\n",
        "\n",
        "# 限制範圍並四捨五入\n",
        "df[\"sleep_hours\"] = df[\"sleep_hours\"].round(1)\n",
        "df[\"screen_time_hours\"] = df[\"screen_time_hours\"].clip(1, 10).round(1)\n",
        "df[\"study_hours\"] = df[\"study_hours\"].clip(0.5, 6).round(1)\n",
        "df[\"attendance_rate\"] = df[\"attendance_rate\"].clip(60, 100).round(0).astype(int)\n",
        "\n",
        "# ---------- 4. 建立 quiz_score ----------\n",
        "random_noise = rng.normal(loc=0, scale=5, size=n)\n",
        "\n",
        "base_score = 50\n",
        "study_part = 3 * df[\"study_hours\"]\n",
        "sleep_part = 2 * df[\"sleep_hours\"]\n",
        "screen_part = -1.2 * df[\"screen_time_hours\"]\n",
        "attendance_part = 0.15 * df[\"attendance_rate\"]\n",
        "\n",
        "raw_score = (\n",
        "    base_score\n",
        "    + study_part\n",
        "    + sleep_part\n",
        "    + screen_part\n",
        "    + attendance_part\n",
        "    + random_noise\n",
        ")\n",
        "df[\"quiz_score\"] = raw_score.clip(0, 100).round(0).astype(int)\n",
        "\n",
        "# ---------- 5. 加入缺失值與異常值 ----------\n",
        "df.loc[[5, 17], \"sleep_hours\"] = np.nan     # 兩筆睡眠缺失值\n",
